module(
    name = "git_tools",
    version = "0.1.0",
    bazel_compatibility = [">=9.0.0"],
)

bazel_dep(name = "rules_rs", version = "0.1.0")
bazel_dep(name = "llvm", version = "0.8.25")
bazel_dep(name = "platforms", version = "1.1.0")

# Git's macOS fsmonitor uses CoreServices and its framework dependencies, outside
# LLVM's minimal SDK defaults.
osx = use_extension("@llvm//extensions:osx.bzl", "osx")
osx.frameworks(names = [
    "CFNetwork",
    "CoreFoundation",
    "CoreServices",
    "DiskArbitration",
    "DriverKit",
    "Foundation",
    "IOKit",
    "Kernel",
    "OSLog",
    "Security",
    "SystemConfiguration",
])

# Declared fixture tools; tests must not depend on the host Git or Python.
bazel_dep(name = "git", version = "2.55.0")

include("//build_defs:git.MODULE.bazel")

# Git and its HTTP helper must use the same TLS implementation.
bazel_dep(name = "curl", version = "8.11.0.bcr.4")
bazel_dep(name = "rules_python", version = "2.2.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.11")
python.toolchain(python_version = "3.11")
use_repo(python, "python_3_11", "pythons_hub")

register_toolchains("@pythons_hub//:all")

toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
toolchains.toolchain(
    edition = "2024",
    version = "1.98.1",
)
use_repo(toolchains, "default_rust_toolchains")

rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

register_toolchains("@default_rust_toolchains//...", "@llvm//toolchain:all")

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = [
        "x86_64-unknown-linux-gnu",
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "x86_64-pc-windows-msvc",
    ],
)
use_repo(crate, "crates")

include("//build_defs:filesystems.MODULE.bazel")

# Use the pinned Cargo protoc archive as a declared tool, not a Rust library
# retaining an absolute CARGO_MANIFEST_DIR in its compiled output.
crate.annotation(
    additive_build_file_content = """
exports_files(["bin/protoc", "include/google/protobuf/descriptor.proto"])
filegroup(name = "headers", srcs = glob(["include/**"]), visibility = ["//visibility:public"])
""",
    crate = "protoc-bin-vendored-linux-x86_64",
    extra_aliased_targets = {
        "protoc": "bin/protoc",
        "protoc_headers": "headers",
        "protoc_descriptor": "include/google/protobuf/descriptor.proto",
    },
)
crate.annotation(
    additive_build_file_content = 'exports_files(["bin/protoc"])',
    crate = "protoc-bin-vendored-macos-aarch_64",
    extra_aliased_targets = {"protoc_macos_aarch64": "bin/protoc"},
)
crate.annotation(
    additive_build_file_content = 'exports_files(["bin/protoc"])',
    crate = "protoc-bin-vendored-macos-x86_64",
    extra_aliased_targets = {"protoc_macos_x86_64": "bin/protoc"},
)
crate.annotation(
    additive_build_file_content = 'exports_files(["bin/protoc.exe"])',
    crate = "protoc-bin-vendored-win32",
    extra_aliased_targets = {"protoc_windows": "bin/protoc.exe"},
)
