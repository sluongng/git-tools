load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "tinytree-search",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "tinytree_search",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
)

rust_test(
    name = "unit_tests",
    crate = ":tinytree-search",
    edition = "2024",
)
