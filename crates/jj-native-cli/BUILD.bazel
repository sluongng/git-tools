# Real mount iteration, selected explicitly; ordinary mount acceptance does not
# compile the benchmark case. Compilation remains remotely executable.
fixture_test(
    name = "gc_benchmarks",
    size = "large",
    timeout = "long",
    args = [
        "--ignored",
        "native_gc_iteration_benchmark",
        "--nocapture",
        "--test-threads=1",
    ],
    binary = ":gc_benchmark_fixture",
    tags = [
        "local",
        "manual",
    ],
)

rust_test(
    name = "production_unit_tests",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "tinytree_jj",
    crate_root = "src/main.rs",
    edition = "2024",
    version = "0.1.0",
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
