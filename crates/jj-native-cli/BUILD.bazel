)

# Shipped tt workflow on a real Linux mount. The declared checker subprocess is
# an orchestration fixture, not evidence of real Bazel/RBE execution.
rust_test(
    name = "forge_mount_fixture",
    srcs = ["tests/mounted.rs"],
    aliases = aliases(),
    crate_features = ["forge-cli"],
    data = [
        ":tt",
        ":landing_fault_driver",
        "//crates/workspace-daemon:workspace",
        "//crates/tinytree-server:checker_fixture",
    ],
    edition = "2024",
    rustc_env = {
        "CARGO_BIN_EXE_tinytree-jj": "$(rootpath :tt)",
        "CARGO_BIN_EXE_landing_fault_driver": "$(rootpath :landing_fault_driver)",
        "CARGO_BIN_EXE_workspace": "$(rootpath //crates/workspace-daemon:workspace)",
        "TINYTREE_CHECKER_FIXTURE": "$(rootpath //crates/tinytree-server:checker_fixture)",
    },
    tags = ["manual"],
    deps = all_crate_deps(normal = True, normal_dev = True),
)

fixture_test(
    name = "forge_mounted_tests",
    binary = ":forge_mount_fixture",
    args = [
        "--ignored",
        "forge_product_mounted_push_check_land_reconcile_preserves_iteration",
