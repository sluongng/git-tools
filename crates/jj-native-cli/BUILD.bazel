load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//build_defs:fixture_test.bzl", "fixture_test")

package(default_visibility = ["//visibility:public"])

rust_binary(
    name = "tinytree-jj",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "tinytree_jj",
    crate_root = "src/main.rs",
    edition = "2024",
    version = "0.1.0",
    deps = all_crate_deps(normal = True),
)

# Product CLI uses the same native Store, command fence and lazy working copy.
rust_binary(
    name = "tt",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = ["forge-cli"],
    crate_name = "tt",
    crate_root = "src/main.rs",
    edition = "2024",
    version = "0.1.0",
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "forge_unit_tests",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = ["forge-cli"],
    crate_name = "tt",
    crate_root = "src/main.rs",
    edition = "2024",
    version = "0.1.0",
    deps = all_crate_deps(normal = True, normal_dev = True),
)

rust_test(
    name = "forge_cli_tests",
    srcs = ["tests/cli.rs"],
    aliases = aliases(),
    crate_features = ["forge-cli"],
    data = [":tt", ":protocol_fixture", "//crates/tinytree-server:checker_fixture"],
    edition = "2024",
    args = ["forge_product_"],
    env = {
        "FORGE_TEST_TOKEN": "public-forge-fixture-token-not-a-secret",
        "FORGE_TWO_CHECKER_TOKEN": "public-two-account-checker-token-not-a-secret",
    },
    rustc_env = {
        "TINYTREE_CHECKER_FIXTURE": "$(rootpath //crates/tinytree-server:checker_fixture)",
        "CARGO_BIN_EXE_tt": "$(rootpath :tt)",
        "CARGO_BIN_EXE_tinytree-jj": "$(rootpath :protocol_fixture)",
    },
    deps = all_crate_deps(normal_dev = True),
)

# Actual native implementation with process-kill gates, never a materialized fixture.
rust_binary(
    name = "landing_fault_driver",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = ["native-landing-fault-injection"],
    crate_name = "tinytree_landing_fault_driver",
    crate_root = "src/main.rs",
    edition = "2024",
    version = "0.1.0",
    deps = all_crate_deps(normal = True),
)

# Lower-level repository/publication scenarios. Never the shipped CLI.
rust_binary(
    name = "protocol_fixture",
    testonly = True,
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = ["protocol-fixture"],
    crate_name = "tinytree_protocol_fixture",
    crate_root = "src/main.rs",
    edition = "2024",
    version = "0.1.0",
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "cli_tests",
    srcs = ["tests/cli.rs"],
    aliases = aliases(),
    data = [":protocol_fixture"],
    edition = "2024",
    env = {
        "TINYTREE_CLI_WRITER_TOKEN": "public-cli-writer-token-not-a-secret",
        "TINYTREE_CLI_READER_TOKEN": "public-cli-reader-token-not-a-secret",
    },
    rustc_env = {"CARGO_BIN_EXE_tinytree-jj": "$(rootpath :protocol_fixture)"},
    version = "0.1.0",
    deps = all_crate_deps(normal_dev = True),
)

rust_test(
    name = "unit_tests",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = ["protocol-fixture"],
    crate_name = "tinytree_jj",
    crate_root = "src/main.rs",
    edition = "2024",
    version = "0.1.0",
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_test(
    name = "mount_fixture",
    srcs = ["tests/mounted.rs"],
    aliases = aliases(),
    data = [
        ":tinytree-jj",
        ":landing_fault_driver",
        "//crates/workspace-daemon:workspace",
    ],
    edition = "2024",
    rustc_env = {
        "CARGO_BIN_EXE_tinytree-jj": "$(rootpath :tinytree-jj)",
        "CARGO_BIN_EXE_landing_fault_driver": "$(rootpath :landing_fault_driver)",
        "CARGO_BIN_EXE_workspace": "$(rootpath //crates/workspace-daemon:workspace)",
    },
    tags = ["manual"],
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

fixture_test(
    name = "mounted_tests",
    args = ["--ignored"],
    binary = ":mount_fixture",
    tags = [
        "local",
        "manual",
    ],
)

