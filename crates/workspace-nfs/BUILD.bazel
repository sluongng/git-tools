load("@crates//:defs.bzl", "aliases")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//build_defs:fixture_test.bzl", "fixture_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "workspace-nfs",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    aliases = aliases(),
    crate_name = "workspace_nfs",
    edition = "2024",
    deps = [
        "//crates/workspace-core",
        "//crates/workspace-overlay",
    ] + [
        "@crates//:nfsserve",
        "@crates//:anyhow",
        "@crates//:async-trait",
        "@crates//:blake3",
        "@crates//:clap",
        "@crates//:libc",
        "@crates//:tokio",
    ],
)

rust_binary(
    name = "git-nfs-bin",
    srcs = ["src/main.rs"],
    aliases = aliases(),
    crate_name = "workspace_nfs",
    edition = "2024",
    deps = [
        ":workspace-nfs",
        "//crates/workspace-core",
        "//crates/workspace-overlay",
    ] + [
        "@crates//:nfsserve",
        "@crates//:anyhow",
        "@crates//:async-trait",
        "@crates//:blake3",
        "@crates//:clap",
        "@crates//:libc",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "integration_tests_binary",
    srcs = ["tests/integration.rs"],
    aliases = aliases(),
    data = [":git-nfs-bin"],
    edition = "2024",
    rustc_env = {"CARGO_BIN_EXE_git-nfs": "$(rootpath :git-nfs-bin)"},
    tags = ["manual"],
    deps = [
        ":workspace-nfs",
        "//crates/workspace-core",
        "//crates/workspace-overlay",
        "@crates//:nfsserve",
        "@crates//:tempfile",
        "@crates//:tokio",
    ],
)

fixture_test(
    name = "integration_tests",
    binary = ":integration_tests_binary",
    git = True,
)
