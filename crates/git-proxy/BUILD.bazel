load("//build_defs:local_test.bzl", "local_test")
load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "git-proxy",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    crate_name = "git_proxy",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    aliases = aliases(),
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "unit_tests_binary",
    crate = ":git-proxy",
    tags = ["manual"],
    aliases = aliases(),
    deps = all_crate_deps(normal_dev = True),
    compile_data = glob(["testdata/**"]),
)

local_test(
    name = "unit_tests",
    binary = ":unit_tests_binary",
)

rust_binary(
    name = "git-proxy-bin",
    srcs = ["src/main.rs"],
    crate_name = "git_proxy",
    edition = "2024",
    version = "0.1.0",
    aliases = aliases(),
    deps = [":git-proxy"] + all_crate_deps(normal = True),
)

# Native Git and, for ignored cases, /dev/fuse are host integration fixtures.
rust_test(
    name = "integration_tests_binary",
    srcs = ["tests/proxy.rs"],
    edition = "2024",
    version = "0.1.0",
    aliases = aliases(),
    data = [":git-proxy-bin"],
    rustc_env = {"CARGO_BIN_EXE_git-proxy": "$(rootpath :git-proxy-bin)"},
    deps = [":git-proxy"] + all_crate_deps(normal = True, normal_dev = True),
    tags = ["manual"],
)

local_test(
    name = "integration_tests",
    binary = ":integration_tests_binary",
)
