load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//build_defs:fixture_test.bzl", "fixture_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "native-workspace-admin",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "native_workspace_admin",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "unit_tests",
    aliases = aliases(),
    crate = ":native-workspace-admin",
    edition = "2024",
    deps = all_crate_deps(normal_dev = True),
)

# Only this actual kernel acceptance action runs locally; compilation uses RBE.
fixture_test(
    name = "mounted_tests",
    binary = ":unit_tests",
    args = ["--ignored", "native_capture_rejects_another_workspace_before_private_reads"],
    tags = ["local", "manual"],
)
