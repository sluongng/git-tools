load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rs//rs:cargo_build_script.bzl", "cargo_build_script")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

cargo_build_script(
    name = "build_script",
    srcs = ["bazel_build.rs"],
    aliases = aliases(),
    build_script_env = {
        "PROTOC": "$(execpath //build_defs:protoc)",
        "PROTOC_DESCRIPTOR": "$(execpath @crates//:protoc_descriptor)",
        "PROTO_IMPORT_FILES": "$(execpaths //crates/reapi:proto_files)",
    },
    data = glob(["proto/**"]) + [
        "//crates/reapi:proto_files",
        "@crates//:protoc_descriptor",
        "@crates//:protoc_headers",
    ],
    edition = "2024",
    pkg_name = "bazel-output-service",
    tools = ["//build_defs:protoc"],
    version = "0.1.0",
    deps = ["@crates//:tonic-prost-build"],
)

rust_library(
    name = "bazel-output-service",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    aliases = aliases(),
    crate_name = "bazel_output_service",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    deps = [":build_script"] + all_crate_deps(normal = True),
)

rust_binary(
    name = "git-output-service-bin",
    srcs = ["src/main.rs"],
    aliases = aliases(),
    crate_name = "bazel_output_service",
    edition = "2024",
    version = "0.1.0",
    deps = [":bazel-output-service"] + all_crate_deps(normal = True),
)

rust_test(
    name = "integration_tests",
    srcs = ["tests/service.rs"],
    aliases = aliases(),
    edition = "2024",
    version = "0.1.0",
    deps = [":bazel-output-service"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# Exercise the public CLI/TOML resolution path, including lazy admission policy.
rust_test(
    name = "config_tests",
    srcs = ["src/main.rs"],
    aliases = aliases(),
    compile_data = ["//:examples/bazel-output-service.toml"],
    edition = "2024",
    version = "0.1.0",
    deps = [":bazel-output-service"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
