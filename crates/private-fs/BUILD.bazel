load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//build_defs:fixture_test.bzl", "fixture_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "private-fs",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "private_fs",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "unit_tests",
    aliases = aliases(),
    crate = ":private-fs",
    edition = "2024",
    deps = all_crate_deps(normal_dev = True),
)

fixture_test(
    name = "landlock_tests",
    binary = ":unit_tests",
    args = ["--ignored", "--exact", "tests::private_directory_operations_under_landlock"],
    tags = ["local", "manual"],
    target_compatible_with = ["@platforms//os:linux"],
)
