load("//build_defs:local_test.bzl", "local_test")
load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "jj-vfs",
    srcs = ["src/lib.rs"],
    crate_name = "jj_vfs",
    edition = "2024",
    version = "0.1.0",
    aliases = aliases(),
    deps = all_crate_deps(normal = True),
)

rust_binary(
    name = "git-jj-bin",
    srcs = ["src/main.rs"],
    crate_name = "jj_vfs",
    edition = "2024",
    version = "0.1.0",
    aliases = aliases(),
    deps = [":jj-vfs"] + all_crate_deps(normal = True),
)

rust_test(
    name = "lifecycle_binary",
    srcs = ["tests/lifecycle.rs"],
    edition = "2024",
    version = "0.1.0",
    aliases = aliases(),
    data = [":git-jj-bin", "//crates/workspace-fuse:git-vfs-bin"],
    rustc_env = {
        "CARGO_BIN_EXE_git-jj": "$(rootpath :git-jj-bin)",
        "GIT_VFS_BIN": "$(rootpath //crates/workspace-fuse:git-vfs-bin)",
    },
    deps = all_crate_deps(normal_dev = True),
    tags = ["manual"],
)

local_test(name = "lifecycle", binary = ":lifecycle_binary")
