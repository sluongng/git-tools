load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//build_defs:fixture_test.bzl", "fixture_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "jj-vfs",
    srcs = ["src/lib.rs"],
    aliases = aliases(),
    crate_name = "jj_vfs",
    edition = "2024",
    version = "0.1.0",
    deps = all_crate_deps(normal = True),
)

rust_binary(
    name = "git-jj-bin",
    srcs = ["src/main.rs"],
    aliases = aliases(),
    crate_name = "jj_vfs",
    edition = "2024",
    version = "0.1.0",
    deps = [":jj-vfs"] + all_crate_deps(normal = True),
)

rust_test(
    name = "lifecycle_binary",
    srcs = ["tests/lifecycle.rs"],
    aliases = aliases(),
    data = [
        ":git-jj-bin",
        "//crates/workspace-fuse:git-vfs-bin",
    ],
    edition = "2024",
    rustc_env = {
        "CARGO_BIN_EXE_git-jj": "$(rootpath :git-jj-bin)",
        "GIT_VFS_BIN": "$(rootpath //crates/workspace-fuse:git-vfs-bin)",
    },
    tags = ["manual"],
    version = "0.1.0",
    deps = all_crate_deps(normal_dev = True),
)

fixture_test(
    name = "lifecycle",
    binary = ":lifecycle_binary",
    git = True,
)

# Explicit kernel/device acceptance: never part of the default RBE test set.
fixture_test(
    name = "mounted_tests",
    args = ["--ignored"],
    binary = ":lifecycle_binary",
    git = True,
    tags = [
        "local",
        "manual",
    ],
)
