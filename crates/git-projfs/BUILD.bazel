load("//build_defs:local_test.bzl", "local_test")
load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "git-projfs",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    crate_name = "git_projfs",
    crate_root = "src/lib.rs",
    crate_features = ["native"],
    edition = "2024",
    version = "0.1.0",
    aliases = aliases(),
    deps = all_crate_deps(normal = True),
)

rust_binary(
    name = "git-projfs-bin",
    srcs = ["src/main.rs"],
    crate_name = "git_projfs",
    crate_features = ["native"],
    edition = "2024",
    version = "0.1.0",
    aliases = aliases(),
    deps = [":git-projfs"] + all_crate_deps(normal = True),
)

rust_test(
    name = "unit_tests_binary",
    crate = ":git-projfs",
    tags = ["manual"],
    aliases = aliases(),
    deps = all_crate_deps(normal_dev = True),
)
local_test(name = "unit_tests", binary = ":unit_tests_binary")

rust_test(
    name = "worktree_tests_binary",
    srcs = ["tests/worktree.rs"],
    edition = "2024",
    version = "0.1.0",
    aliases = aliases(),
    deps = [":git-projfs"] + all_crate_deps(normal = True, normal_dev = True),
    tags = ["manual"],
)
local_test(name = "worktree_tests", binary = ":worktree_tests_binary")
