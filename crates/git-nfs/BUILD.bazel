load("//build_defs:local_test.bzl", "local_test")
load("@crates//:defs.bzl", "aliases")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "git-nfs",
    srcs = ["src/lib.rs"],
    crate_name = "git_nfs",
    edition = "2024",
    aliases = aliases(),
    deps = ["//crates/git-overlay", "//crates/git-workspace"] + [
        "//third_party/nfsserve",
        "@crates//:anyhow", "@crates//:async-trait", "@crates//:blake3",
        "@crates//:clap", "@crates//:libc", "@crates//:tokio",
    ],
)

rust_binary(
    name = "git-nfs-bin",
    srcs = ["src/main.rs"],
    crate_name = "git_nfs",
    edition = "2024",
    aliases = aliases(),
    deps = [":git-nfs", "//crates/git-overlay", "//crates/git-workspace"] + [
        "//third_party/nfsserve",
        "@crates//:anyhow", "@crates//:async-trait", "@crates//:blake3",
        "@crates//:clap", "@crates//:libc", "@crates//:tokio",
    ],
)

rust_test(
    name = "integration_tests_binary",
    srcs = ["tests/integration.rs"],
    edition = "2024",
    aliases = aliases(),
    deps = [":git-nfs", "//crates/git-overlay", "//crates/git-workspace", "//third_party/nfsserve", "@crates//:tokio", "@crates//:tempfile"],
    data = [":git-nfs-bin"],
    rustc_env = {"CARGO_BIN_EXE_git-nfs": "$(rootpath :git-nfs-bin)"},
    tags = ["manual"],
)
local_test(
    name = "integration_tests",
    binary = ":integration_tests_binary",
)
