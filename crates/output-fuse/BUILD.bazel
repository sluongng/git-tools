load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//build_defs:local_test.bzl", "local_test")

package(default_visibility = ["//visibility:public"])

_DEPS = [
    "//crates/output-core",
    "//third_party/fuser",
    "@crates//:anyhow",
    "@crates//:async-trait",
    "@crates//:libc",
    "@crates//:tokio",
]

rust_library(
    name = "output-fuse",
    crate_name = "output_fuse",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    version = "0.1.0",
    deps = _DEPS,
)

rust_test(
    name = "integration_tests_binary",
    srcs = ["tests/mounted.rs"],
    edition = "2024",
    deps = [":output-fuse", "@crates//:blake3", "@crates//:tempfile"] + _DEPS,
    tags = ["manual"],
)
local_test(name = "integration_tests", binary = ":integration_tests_binary")
