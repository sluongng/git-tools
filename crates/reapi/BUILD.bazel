load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:cargo_build_script.bzl", "cargo_build_script")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//build_defs:local_test.bzl", "local_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "proto_files",
    srcs = glob(["proto/**"]),
)

cargo_build_script(
    name = "build_script",
    srcs = ["//build_defs:reapi_build.rs"],
    edition = "2024",
    version = "0.1.0",
    pkg_name = "reapi",
    aliases = aliases(),
    data = glob(["proto/**"]) + ["@crates//:protoc_headers", "@crates//:protoc_descriptor"],
    tools = ["@crates//:protoc"],
    build_script_env = {
        "PROTOC": "$(execpath @crates//:protoc)",
        "PROTOC_DESCRIPTOR": "$(execpath @crates//:protoc_descriptor)",
    },
    deps = ["@crates//:tonic-prost-build"],
)

rust_library(
    name = "reapi",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    crate_name = "reapi",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    aliases = aliases(),
    deps = [":build_script"] + all_crate_deps(normal = True),
)

rust_test(
    name = "unit_tests_binary",
    crate = ":reapi",
    edition = "2024",
    aliases = aliases(),
    deps = all_crate_deps(normal = True),
    tags = ["manual"],
)

local_test(name = "unit_tests", binary = ":unit_tests_binary")
