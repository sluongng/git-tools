load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "tinytree-inventory",
    srcs = ["src/lib.rs"],
    aliases = aliases(),
    crate_name = "tinytree_inventory",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = all_crate_deps(normal = True),
)

rust_binary(
    name = "inventory",
    srcs = ["src/main.rs"],
    aliases = aliases(),
    crate_root = "src/main.rs",
    edition = "2024",
    deps = [":tinytree-inventory"] + all_crate_deps(normal = True),
)

rust_test(
    name = "unit_tests",
    aliases = aliases(),
    crate = ":tinytree-inventory",
    edition = "2024",
    deps = all_crate_deps(normal = True, normal_dev = True),
)

rust_binary(
    name = "checker_status",
    srcs = ["src/checker_status.rs"],
    aliases = aliases(),
    crate_root = "src/checker_status.rs",
    edition = "2024",
    deps = all_crate_deps(normal = True),
)
