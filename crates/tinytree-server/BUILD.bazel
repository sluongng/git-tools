load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

load("//build_defs:fixture_test.bzl", "fixture_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "tinytree-server",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    aliases = aliases(),
    compile_data = [
        "examples/cloud.toml",
        "examples/landing.toml",
        "//crates/tinytree-ui:index.html",
        "//crates/tinytree-ui:app.js",
        "//crates/tinytree-ui:style.css",
        "//crates/tinytree-ui:wasm",
    ],
    rustc_env = {
        "TINYTREE_UI_WASM": "$(execpath //crates/tinytree-ui:wasm)",
        "TINYTREE_UI_HTML": "$(execpath //crates/tinytree-ui:index.html)",
        "TINYTREE_UI_JS": "$(execpath //crates/tinytree-ui:app.js)",
        "TINYTREE_UI_CSS": "$(execpath //crates/tinytree-ui:style.css)",
    },
    crate_name = "tinytree_server",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    deps = all_crate_deps(normal = True),
)

rust_binary(
    name = "tinytree",
    srcs = ["src/main.rs"],
    aliases = aliases(),
    crate_name = "tinytree",
    edition = "2024",
    version = "0.1.0",
    deps = [":tinytree-server"] + all_crate_deps(normal = True),
)

rust_test(
    name = "unit_tests",
    aliases = aliases(),
    crate = ":tinytree-server",
    edition = "2024",
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_test(
    name = "rpc_tests",
    compile_data = ["examples/cloud.toml", "examples/landing.toml"],
    srcs = ["tests/rpc.rs"],
    aliases = aliases(),
    edition = "2024",
    data = [":checker_fixture"],
    rustc_env = {"TINYTREE_CHECKER_FIXTURE": "$(rootpath :checker_fixture)"},
    deps = [":tinytree-server"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_binary(
    name = "checker_fixture",
    testonly = True,
    srcs = ["tests/checker_fixture.rs"],
    edition = "2024",
    deps = [
        "//crates/tinytree-check-runner:tinytree-check-runner",
        "@crates//:serde_json",
        "@crates//:libc",
    ],
)

rust_test(
    name = "tls_tests",
    srcs = ["tests/tls.rs"],
    aliases = aliases(),
    data = [
        "tests/fixtures/ca.pem",
        "tests/fixtures/server-key.pem",
        "tests/fixtures/server.pem",
        "tests/fixtures/wrong-ca.pem",
    ],
    edition = "2024",
    env = {"TINYTREE_PUBLIC_TLS_TEST_TOKEN": "public-tls-test-token-not-a-secret"},
    rustc_env = {
        "TLS_CA_CERT": "$(rootpath tests/fixtures/ca.pem)",
        "TLS_SERVER_CERT": "$(rootpath tests/fixtures/server.pem)",
        "TLS_SERVER_KEY": "$(rootpath tests/fixtures/server-key.pem)",
        "TLS_WRONG_CA_CERT": "$(rootpath tests/fixtures/wrong-ca.pem)",
    },
    deps = [":tinytree-server"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_test(
    name = "unix_tests",
    srcs = ["tests/unix.rs"],
    aliases = aliases(),
    data = [":tinytree"],
    edition = "2024",
    rustc_env = {"CARGO_BIN_EXE_tinytree": "$(rootpath :tinytree)"},
    deps = [":tinytree-server"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# Compile the actual runner/workspace remotely; only genuine Linux/FUSE/RBE
# execution is local and explicitly selected. Runtime site settings stay external.
rust_test(
    name = "forge_native_checker_fixture",
    srcs = ["tests/rpc.rs"],
    compile_data = ["examples/cloud.toml", "examples/landing.toml"],
    data = [
        ":checker_fixture",
        "//crates/tinytree-check-runner:tinytree-check-runner-bin",
        "//crates/workspace-daemon:workspace",
    ],
    rustc_env = {
        "TINYTREE_CHECKER_FIXTURE": "$(rootpath :checker_fixture)",
        "TINYTREE_ACCEPTANCE_RUNNER": "$(rootpath //crates/tinytree-check-runner:tinytree-check-runner-bin)",
        "TINYTREE_ACCEPTANCE_WORKSPACE": "$(rootpath //crates/workspace-daemon:workspace)",
    },
    aliases = aliases(),
    edition = "2024",
    tags = ["manual"],
    deps = [":tinytree-server"] + all_crate_deps(normal = True, normal_dev = True),
)

fixture_test(
    name = "forge_native_checker_acceptance",
    binary = ":forge_native_checker_fixture",
    script = "tests/forge-native-checker.sh",
    binary_env = "TINYTREE_ACCEPTANCE_TEST_BINARY",
    tags = ["local", "manual"],
    size = "large",
    timeout = "long",
)

# Parent-controlled real browser acceptance. Compilation remains remote; the
# temporary HTTP provider must share the browser's local loopback namespace.
rust_test(
    name = "forge_browser_provider_fixture",
    aliases = aliases(),
    crate = ":tinytree-server",
    edition = "2024",
    tags = ["manual"],
    deps = all_crate_deps(normal = True, normal_dev = True),
)

fixture_test(
    name = "forge_browser_provider_acceptance",
    binary = ":forge_browser_provider_fixture",
    script = "tests/forge-browser-provider.sh",
    binary_env = "TINYTREE_BROWSER_TEST_BINARY",
    tags = ["local", "manual"],
    size = "large",
    timeout = "long",
)
