load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//build_defs:fixture_test.bzl", "fixture_test")

_VFS_DEPS = [
    "//crates/workspace-overlay",
    "//crates/workspace-core",
    "@crates//:fuser",
    "@crates//:anyhow",
    "@crates//:blake3",
    "@crates//:clap",
    "@crates//:ctrlc",
    "@crates//:hex",
    "@crates//:libc",
    "@crates//:serde",
    "@crates//:serde_json",
]

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "workspace-fuse",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    aliases = aliases(),
    crate_name = "workspace_fuse",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    deps = _VFS_DEPS,
)

rust_binary(
    name = "git-vfs-bin",
    srcs = ["src/main.rs"],
    aliases = aliases(),
    crate_name = "workspace_fuse",
    edition = "2024",
    version = "0.1.0",
    deps = [":workspace-fuse"] + _VFS_DEPS,
)

# Git/Python fixtures run remotely; ignored mount cases remain opt-in.
rust_test(
    name = "integration_tests_binary",
    srcs = ["tests/integration.rs"],
    aliases = aliases(),
    data = [":git-vfs-bin"],
    edition = "2024",
    rustc_env = {"CARGO_BIN_EXE_git-vfs": "$(rootpath :git-vfs-bin)"},
    tags = ["manual"],
    version = "0.1.0",
    deps = [":workspace-fuse"] + _VFS_DEPS + all_crate_deps(normal_dev = True),
)

fixture_test(
    name = "integration_tests",
    binary = ":integration_tests_binary",
    git = True,
    python = True,
)

# Explicit kernel/device acceptance: never part of the default RBE test set.
fixture_test(
    name = "mounted_tests",
    args = ["--ignored"],
    binary = ":integration_tests_binary",
    git = True,
    python = True,
    tags = [
        "local",
        "manual",
    ],
)
