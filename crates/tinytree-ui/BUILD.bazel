load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_shared_library.bzl", "rust_shared_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["index.html", "app.js", "style.css"])

filegroup(
    name = "assets",
    srcs = ["index.html", "app.js", "style.css"],
)

rust_library(
    name = "tinytree-ui",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "tinytree_ui",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    deps = all_crate_deps(normal = True),
)

# Transition only the browser client, leaving the server and tests native.
rust_shared_library(
    name = "wasm",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "tinytree_ui",
    crate_root = "src/lib.rs",
    edition = "2024",
    platform = "@rules_rs//rs/platforms:wasm32-unknown-unknown",
    rustc_flags = ["-Copt-level=z", "-Cstrip=debuginfo"],
    version = "0.1.0",
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "unit_tests",
    aliases = aliases(),
    crate = ":tinytree-ui",
    edition = "2024",
    deps = all_crate_deps(normal = True),
)
