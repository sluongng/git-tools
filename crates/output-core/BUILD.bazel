load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//build_defs:local_test.bzl", "local_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "output-core",
    crate_name = "output_core",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    version = "0.1.0",
    aliases = aliases(),
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "unit_tests_binary",
    crate = ":output-core",
    edition = "2024",
    aliases = aliases(),
    deps = all_crate_deps(normal = True, normal_dev = True),
    tags = ["manual"],
)
local_test(name = "unit_tests", binary = ":unit_tests_binary")
