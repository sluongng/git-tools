load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("//build_defs:fixture_test.bzl", "fixture_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "output-nfs",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "output_nfs",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "unit_tests",
    aliases = aliases(),
    crate = ":output-nfs",
    edition = "2024",
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

rust_test(
    name = "integration_tests",
    srcs = ["tests/projection.rs"],
    aliases = aliases(),
    edition = "2024",
    deps = [":output-nfs"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

fixture_test(
    name = "native_tests",
    args = [
        "--ignored",
        "--exact",
        "native_publication_and_mutation",
    ],
    binary = ":integration_tests",
    exec_compatible_with = ["@platforms//os:macos"],
    tags = [
        "local",
        "manual",
    ],
    target_compatible_with = ["@platforms//os:macos"],
)
