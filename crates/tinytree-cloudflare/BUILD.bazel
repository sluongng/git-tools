load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_shared_library.bzl", "rust_shared_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "tinytree-cloudflare",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "tinytree_cloudflare",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    deps = all_crate_deps(normal = True),
)

rust_shared_library(
    name = "wasm",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "tinytree_cloudflare",
    crate_root = "src/lib.rs",
    edition = "2024",
    platform = "@rules_rs//rs/platforms:wasm32-unknown-unknown",
    rustc_flags = ["-Copt-level=z", "-Cstrip=debuginfo"],
    version = "0.1.0",
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "unit_tests",
    aliases = aliases(),
    crate = ":tinytree-cloudflare",
    edition = "2024",
    deps = all_crate_deps(normal = True),
)

rust_binary(
    name = "contract_fixture",
    testonly = True,
    srcs = ["tests/contract_fixture.rs"],
    aliases = aliases(),
    crate_root = "tests/contract_fixture.rs",
    edition = "2024",
    deps = [":tinytree-cloudflare"] + all_crate_deps(normal = True, normal_dev = True),
)
