load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "output-projfs",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "output_projfs",
    crate_root = "src/lib.rs",
    edition = "2024",
    version = "0.1.0",
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "unit_tests",
    aliases = aliases(),
    crate = ":output-projfs",
    edition = "2024",
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

# Uses the actual NTFS provider and external native clients.
rust_test(
    name = "native_tests",
    srcs = ["tests/native.rs"],
    aliases = aliases(),
    args = ["--ignored"],
    compile_data = glob(["tests/support/*.py"]),
    edition = "2024",
    env_inherit = [
        "OUTPUT_PROJFS_TEST_PYTHON",
        "PATH",
        "SYSTEMROOT",
        "TEMP",
        "TMP",
    ],
    exec_compatible_with = ["@platforms//os:windows"],
    tags = [
        "local",
        "manual",
    ],
    target_compatible_with = ["@platforms//os:windows"],
    deps = [":output-projfs"] + all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)
