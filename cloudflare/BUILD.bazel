load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_run_binary", "js_test")
load("@cloudflare_npm//:defs.bzl", "npm_link_all_packages")
load("@cloudflare_npm//cloudflare:wrangler/package_json.bzl", wrangler_bin = "bin")

package(default_visibility = ["//visibility:public"])

exports_files(["package.json", "pnpm-lock.yaml"])

npm_link_all_packages(name = "node_modules")

js_binary(
    name = "bundle_tool",
    entry_point = "tools/bundle.mjs",
    data = [":node_modules/esbuild"],
)

js_run_binary(
    name = "worker",
    tool = ":bundle_tool",
    srcs = glob(["src/**/*.ts"]) + ["//crates/tinytree-cloudflare:wasm"],
    outs = ["worker.mjs", "core.wasm"],
    args = [
        "cloudflare/src/index.ts",
        "$(execpath //crates/tinytree-cloudflare:wasm)",
        "$(RULEDIR)/worker.mjs",
        "$(RULEDIR)/core.wasm",
    ],
    mnemonic = "WorkerBundle",
)

# One declared deployment tree; UI Wasm is a static browser asset, not the
# repository core's CompiledWasm module. No provider resources are selected here.
js_binary(
    name = "package_tool",
    entry_point = "tools/package.mjs",
)

js_run_binary(
    name = "release_package",
    tool = ":package_tool",
    # package.mjs resolves declared source paths from the execution root;
    # rules_js cannot copy another package's source assets into this package.
    copy_srcs_to_bin = False,
    srcs = [
        ":worker",
        "wrangler.jsonc",
        "//crates/tinytree-ui:assets",
        "//crates/tinytree-ui:wasm",
    ],
    outs = [
        "release/worker.mjs",
        "release/core.wasm",
        "release/wrangler.jsonc",
        "release/ui-assets/ui/index.html",
        "release/ui-assets/ui/app.js",
        "release/ui-assets/ui/style.css",
        "release/ui-assets/ui/tinytree_ui.wasm",
    ],
    args = [
        "$(RULEDIR)/worker.mjs",
        "$(RULEDIR)/core.wasm",
        "cloudflare/wrangler.jsonc",
        "crates/tinytree-ui/index.html",
        "crates/tinytree-ui/app.js",
        "crates/tinytree-ui/style.css",
        "$(execpath //crates/tinytree-ui:wasm)",
        "$(RULEDIR)/release",
    ],
    mnemonic = "WorkerReleasePackage",
)

js_test(
    name = "typecheck",
    include_types = True,
    entry_point = "tools/typecheck.mjs",
    data = glob(["src/**/*.ts", "tests/**/*.ts", "tools/*.d.ts"]) + [
        "tsconfig.json",
        ":node_modules/typescript",
        ":node_modules/@cloudflare/workers-types",
    ],
)

# Test-only module harness; never a production Worker or deployment dependency.
js_run_binary(
    name = "closure_job_harness",
    testonly = True,
    tool = ":bundle_tool",
    srcs = glob(["src/**/*.ts"]) + ["tests/closure-harness.ts", "//crates/tinytree-cloudflare:wasm"],
    outs = ["closure-harness/worker.mjs", "closure-harness/core.wasm"],
    args = [
        "cloudflare/tests/closure-harness.ts",
        "$(execpath //crates/tinytree-cloudflare:wasm)",
        "$(RULEDIR)/closure-harness/worker.mjs",
        "$(RULEDIR)/closure-harness/core.wasm",
    ],
    mnemonic = "ClosureHarnessBundle",
)

# Real workerd runtime, SQLite Durable Objects and R2; no host Node or services.
js_run_binary(
    name = "projection_harness",
    testonly = True,
    tool = ":bundle_tool",
    srcs = glob(["src/**/*.ts"]) + ["tests/projection-harness.ts", "//crates/tinytree-cloudflare:wasm"],
    outs = ["projection-harness/worker.mjs", "projection-harness/core.wasm"],
    args = [
        "cloudflare/tests/projection-harness.ts",
        "$(execpath //crates/tinytree-cloudflare:wasm)",
        "$(RULEDIR)/projection-harness/worker.mjs",
        "$(RULEDIR)/projection-harness/core.wasm",
    ],
    mnemonic = "ProjectionHarnessBundle",
)

# Both harnesses are test-only; the deployed Worker never imports their routes.
js_test(
    name = "runtime_tests",
    entry_point = "tools/runner.mjs",
    args = [
        "$(rootpath //crates/tinytree-cloudflare:contract_fixture)",
        "$(rootpath //crates/jj-native-cli:tt)",
    ],
    data = [
        "tests/runtime.test.mjs",
        ":closure_job_harness",
        ":projection_harness",
        ":release_package",
        ":node_modules/miniflare",
        "//crates/tinytree-cloudflare:contract_fixture",
        "//crates/jj-native-cli:tt",
    ],
    timeout = "moderate",
)

# Real Linux namespace and remote-execution acceptance, selected explicitly.
js_test(
    name = "checker_acceptance",
    entry_point = "tools/checker-acceptance.mjs",
    no_copy_to_bin = ["@checker_bazel_linux_x86_64//file"],
    args = [
        "$(rootpath //crates/tinytree-cloudflare:contract_fixture)",
        "$(rootpath //crates/tinytree-check-runner:tinytree-check-runner-bin)",
        "$(rootpath //crates/tinytree-check-runner:readonly_snapshot_helper)",
        "$(rootpath @checker_bazel_linux_x86_64//file)",
        "cloudflare/worker.mjs",
        "cloudflare/core.wasm",
        "$(rootpath //crates/jj-native-cli:tt)",
    ],
    data = [
        ":worker",
        ":node_modules/miniflare",
        "//crates/tinytree-cloudflare:contract_fixture",
        "//crates/tinytree-check-runner:tinytree-check-runner-bin",
        "//crates/tinytree-check-runner:readonly_snapshot_helper",
        "//crates/jj-native-cli:tt",
        "@checker_bazel_linux_x86_64//file",
    ],
    tags = ["local", "manual"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    timeout = "long",
)

# Explicit local interactive acceptance, never a deployed Worker entrypoint.
js_binary(
    name = "browser_fixture",
    testonly = True,
    entry_point = "tools/browser-fixture.mjs",
    args = ["$(rootpath //crates/tinytree-cloudflare:contract_fixture)"],
    data = [
        ":release_package",
        ":projection_harness",
        ":node_modules/miniflare",
        "//crates/tinytree-cloudflare:contract_fixture",
    ],
)

# Invoke the package-declared CLI bin, not an unexported module subpath.
# Operators select deployment configuration explicitly with --config.
wrangler_bin.wrangler_binary(
    name = "wrangler",
    env = {"WRANGLER_SEND_METRICS": "false"},
    tags = ["manual"],
)

js_test(
    name = "wrangler_smoke_tests",
    entry_point = "tools/wrangler-smoke.mjs",
    # These are read-only comparison inputs, never imported as ESM modules.
    # Keep the normal copied entrypoint and package dependency behavior.
    no_copy_to_bin = ["//crates/tinytree-ui:assets"],
    args = ["$(rootpath :wrangler)", "$(rootpath //crates/tinytree-ui:wasm)"],
    data = [
        ":wrangler",
        ":node_modules/wrangler",
        ":worker",
        ":release_package",
        "package.json",
        "//crates/tinytree-ui:assets",
        "//crates/tinytree-ui:wasm",
    ],
)
