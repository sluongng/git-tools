exports_files(["Cargo.toml", "Cargo.lock", "examples/bazel-output-service.toml", "examples/workspace.toml"])

platform(
    name = "rbe_linux_x86_64",
    constraint_values = ["@platforms//cpu:x86_64", "@platforms//os:linux"],
    exec_properties = {
        "OSFamily": "Linux",
        "container-image": "docker://gcr.io/flame-public/rbe-ubuntu22-04@sha256:0d84a80bb0fc36ba5381942adcf6493249594dcc9044845c617b78c9b621cae3",
    },
)

alias(name = "workspace-fuse", actual = "//crates/workspace-fuse:git-vfs-bin", visibility = ["//visibility:public"])
alias(name = "workspace", actual = "//crates/workspace-daemon:workspace", visibility = ["//visibility:public"])
alias(name = "agent-session", actual = "//crates/agent-session:agent-session-bin", visibility = ["//visibility:public"])
alias(name = "git-proxy", actual = "//crates/git-proxy:git-proxy-bin", visibility = ["//visibility:public"])
alias(name = "workspace-nfs", actual = "//crates/workspace-nfs:git-nfs-bin", visibility = ["//visibility:public"])
alias(name = "workspace-projfs", actual = "//crates/workspace-projfs:git-projfs-bin", visibility = ["//visibility:public"])
alias(name = "jj-vfs", actual = "//crates/jj-vfs:git-jj-bin", visibility = ["//visibility:public"])
alias(name = "bazel-output-service", actual = "//crates/bazel-output-service:git-output-service-bin", visibility = ["//visibility:public"])
# Compatibility labels retain existing build commands.
alias(name = "git-vfs", actual = ":workspace-fuse", visibility = ["//visibility:public"])
alias(name = "git-nfs", actual = ":workspace-nfs", visibility = ["//visibility:public"])
alias(name = "git-projfs", actual = ":workspace-projfs", visibility = ["//visibility:public"])
alias(name = "git-jj", actual = ":jj-vfs", visibility = ["//visibility:public"])
alias(name = "git-output-service", actual = ":bazel-output-service", visibility = ["//visibility:public"])
