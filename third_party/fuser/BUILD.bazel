load("@rules_rs//rs:rust_library.bzl", "rust_library")

# The Cargo [patch] includes this exact source. Declare source inputs explicitly:
# the generic path-crate importer would also glob ignored Cargo target/ outputs.
rust_library(
    name = "fuser",
    crate_name = "fuser",
    crate_root = "src/lib.rs",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    version = "0.16.0",
    crate_features = ["abi-7-%d" % version for version in range(19, 32)],
    rustc_flags = [
        "--check-cfg=cfg(test)",
        '--cfg=fuser_mount_impl="pure-rust"',
        '--check-cfg=cfg(feature, values("abi-7-19", "abi-7-20", "abi-7-21", "abi-7-22", "abi-7-23", "abi-7-24", "abi-7-25", "abi-7-26", "abi-7-27", "abi-7-28", "abi-7-29", "abi-7-30", "abi-7-31", "abi-7-36", "abi-7-40", "default", "libfuse", "macfuse-4-compat", "serializable"))',
        '--check-cfg=cfg(fuser_mount_impl, values("pure-rust", "libfuse2", "libfuse3"))',
    ],
    deps = [
        "@crates//:libc-0.2.190",
        "@crates//:log-0.4.34",
        "@crates//:memchr-2.8.3",
        "@crates//:nix-0.29.0",
        "@crates//:page_size-0.6.0",
        "@crates//:smallvec-1.16.3",
        "@crates//:zerocopy-0.8.63",
    ],
    visibility = ["//visibility:public"],
)
