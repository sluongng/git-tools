From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sluongng <26684313+sluongng@users.noreply.github.com>
Date: Wed, 28 Oct 2026 00:00:00 +0000
Subject: [PATCH] jj-core: Bound stock glob matcher construction without panic

Stock glob matcher construction assumes regex compilation cannot fail. Remote
filesets need fallible compilation and aggregate admission rather than one
unlimited compiler allocation per leaf. Add a shared syntax/compiler budget and
bounded builder while preserving the original builder and stock regex/pruning.
Reserve each regex set's configured compiled/cache allowance before compiling;
never refund failed work. Regex engine limits are approximate, not allocator RSS.
Callers admit parsed AST storage, parser work, containers and concurrency
separately. Expose case sensitivity so callers can preserve parsed glob identity.
---
diff --git a/src/matchers.rs b/src/matchers.rs
--- a/src/matchers.rs
+++ b/src/matchers.rs
@@ -14,6 +14,9 @@
 
 //! Contains the [`Matcher`] trait which is used for matching against
 //! [`RepoPath`]s and guiding walks of directory trees.
+
+mod bounded;
+pub use bounded::{MatcherBuildBudget, MatcherBuildError, MatcherBuildLimits, MatcherBuildUsage};
 
 use std::collections::HashSet;
 use std::fmt;
@@ -381,11 +384,67 @@
             matches_prefix_paths,
         }
     }
+
+    /// Compile with aggregate syntax and regex admission shared across the
+    /// complete fileset. Every directory's RegexSet reserves its full configured
+    /// allowance before compilation. No per-leaf budget reset or panic fallback.
+    /// Searches use one cache-pool shard. Callers must serialize physical
+    /// searches (including visit) or separately admit concurrent cache copies.
+    pub fn build_bounded(
+        self,
+        budget: &mut MatcherBuildBudget,
+    ) -> Result<GlobsMatcher, MatcherBuildError> {
+        let Self {
+            mut dir_patterns,
+            matches_prefix_paths,
+        } = self;
+        budget.reserve_globs(dir_patterns.len())?;
+        // Charge borrowed syntax before cloning paths or generating prefix regexes.
+        for (dir, pattern) in &dir_patterns {
+            budget.charge_literal_bytes(dir.as_internal_file_string().len())?;
+            budget.charge_literal_bytes(pattern.as_str().len())?;
+            let bytes = pattern
+                .as_regex()
+                .len()
+                .checked_add(if matches_prefix_paths { 6 } else { 0 })
+                .ok_or(MatcherBuildError::LimitExceeded)?;
+            budget.charge_regex_bytes(bytes)?;
+        }
+        dir_patterns.sort_unstable_by_key(|&(dir, _)| dir);
+
+        let mut tree: RepoPathTree<Option<regex::bytes::RegexSet>> = Default::default();
+        for (dir, chunk) in &dir_patterns.into_iter().chunk_by(|&(dir, _)| dir) {
+            // Based on new_regex() in globset. We don't use GlobSet because
+            // RepoPath separator should be "/" on all platforms.
+            let (compiled_limit, cache_limit) = budget.reserve_regex_set()?;
+            let mut regex_builder = if matches_prefix_paths {
+                let regex_patterns = chunk.map(|(_, pattern)| pattern.to_prefix_regex());
+                regex::bytes::RegexSetBuilder::new(regex_patterns)
+            } else {
+                regex::bytes::RegexSetBuilder::new(chunk.map(|(_, pattern)| pattern.as_regex()))
+            };
+            let regex = regex_builder
+                .dot_matches_new_line(true)
+                .size_limit(compiled_limit)
+                .dfa_size_limit(cache_limit)
+                .pool_capacity(1)
+                .build()
+                .map_err(MatcherBuildError::Regex)?;
+            let sub = tree.add(dir);
+            assert!(sub.value().is_none());
+            sub.set_value(Some(regex));
+        }
+
+        Ok(GlobsMatcher {
+            tree,
+            matches_prefix_paths,
+        })
+    }
 }
 
 /// Wrapper for a [`Glob`] parsed with `literal_separator = true`.
 #[derive(Clone)]
-pub struct PathGlobPattern(Glob);
+pub struct PathGlobPattern(Glob, bool);
 
 impl Debug for PathGlobPattern {
     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
@@ -413,12 +472,17 @@
             .literal_separator(true)
             .case_insensitive(icase)
             .build()?;
-        Ok(Self(glob))
+        Ok(Self(glob, icase))
     }
 
     /// Returns the original glob pattern.
     pub fn as_str(&self) -> &str {
         self.0.glob()
+    }
+
+    /// Whether this pattern was parsed with case-insensitive matching.
+    pub fn case_insensitive(&self) -> bool {
+        self.1
     }
 
     /// Returns the regular expression string for this glob.
