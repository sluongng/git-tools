+/// Aggregate construction limits shared by all leaves of one or more matchers.
+/// Input AST storage/parsing is caller-owned. Regex sizes are the engine's
+/// approximate compiled-size/cache limits, not allocator RSS measurements.
+/// Callers separately admit AST/output containers, concurrency and clones.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct MatcherBuildLimits {
+    pub max_ast_nodes: usize,
+    /// Additionally capped at 256 to bound recursive stock matcher construction.
+    pub max_ast_depth: usize,
+    pub max_literal_bytes: usize,
+    pub max_regex_bytes: usize,
+    pub max_regex_set_bytes: usize,
+    pub max_regex_cache_bytes: usize,
+    pub max_total_regex_memory_bytes: usize,
+}
+impl Default for MatcherBuildLimits {
+    fn default() -> Self {
+        Self {
+            max_ast_nodes: 64,
+            max_ast_depth: 16,
+            max_literal_bytes: 64 * 1024,
+            max_regex_bytes: 1024 * 1024,
+            max_regex_set_bytes: 128 * 1024,
+            max_regex_cache_bytes: 0,
+            max_total_regex_memory_bytes: 8 * 1024 * 1024,
+        }
+    }
+}
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub struct MatcherBuildUsage {
+    pub ast_nodes: usize,
+    pub max_depth: usize,
+    pub literal_bytes: usize,
+    pub regex_bytes: usize,
+    pub regex_sets: usize,
+    /// Full configured compiled/cache allowances, not just successful outputs.
+    /// Reservations are cumulative and are never refunded on compile failure.
+    pub regex_memory_bytes: usize,
+}
+#[derive(Debug)]
+pub enum MatcherBuildError {
+    LimitExceeded,
+    Regex(regex::Error),
+}
+impl std::fmt::Display for MatcherBuildError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::LimitExceeded => f.write_str("matcher construction limit exceeded"),
+            Self::Regex(_) => f.write_str("matcher regex compilation failed"),
+        }
+    }
+}
+impl std::error::Error for MatcherBuildError {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        match self {
+            Self::Regex(error) => Some(error),
+            _ => None,
+        }
+    }
+}
+#[derive(Clone, Debug)]
+pub struct MatcherBuildBudget {
+    limits: MatcherBuildLimits,
+    usage: MatcherBuildUsage,
+    glob_patterns: usize,
+}
+impl MatcherBuildBudget {
+    pub fn new(limits: MatcherBuildLimits) -> Self {
+        Self {
+            limits,
+            usage: MatcherBuildUsage::default(),
+            glob_patterns: 0,
+        }
+    }
+    pub fn usage(&self) -> MatcherBuildUsage {
+        self.usage
+    }
+    fn add(counter: &mut usize, amount: usize, maximum: usize) -> Result<(), MatcherBuildError> {
+        *counter = counter
+            .checked_add(amount)
+            .ok_or(MatcherBuildError::LimitExceeded)?;
+        if *counter > maximum {
+            return Err(MatcherBuildError::LimitExceeded);
+        }
+        Ok(())
+    }
+    pub fn charge_node(&mut self, depth: usize) -> Result<(), MatcherBuildError> {
+        Self::add(&mut self.usage.ast_nodes, 1, self.limits.max_ast_nodes)?;
+        self.usage.max_depth = self.usage.max_depth.max(depth);
+        if depth == 0 || depth > self.limits.max_ast_depth.min(256) {
+            return Err(MatcherBuildError::LimitExceeded);
+        }
+        Ok(())
+    }
+    pub fn charge_literal_bytes(&mut self, bytes: usize) -> Result<(), MatcherBuildError> {
+        Self::add(
+            &mut self.usage.literal_bytes,
+            bytes,
+            self.limits.max_literal_bytes,
+        )
+    }
+    pub fn charge_regex_bytes(&mut self, bytes: usize) -> Result<(), MatcherBuildError> {
+        Self::add(
+            &mut self.usage.regex_bytes,
+            bytes,
+            self.limits.max_regex_bytes,
+        )
+    }
+    pub(super) fn reserve_globs(&mut self, count: usize) -> Result<(), MatcherBuildError> {
+        Self::add(&mut self.glob_patterns, count, self.limits.max_ast_nodes)
+    }
+    pub(super) fn reserve_regex_set(&mut self) -> Result<(usize, usize), MatcherBuildError> {
+        let bytes = self
+            .limits
+            .max_regex_set_bytes
+            .checked_add(self.limits.max_regex_cache_bytes)
+            .ok_or(MatcherBuildError::LimitExceeded)?;
+        Self::add(
+            &mut self.usage.regex_memory_bytes,
+            bytes,
+            self.limits.max_total_regex_memory_bytes,
+        )?;
+        Self::add(&mut self.usage.regex_sets, 1, self.limits.max_ast_nodes)?;
+        Ok((
+            self.limits.max_regex_set_bytes,
+            self.limits.max_regex_cache_bytes,
+        ))
+    }
+}
