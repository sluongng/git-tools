+/// An independently owned index of exactly the configured disambiguation set.
+///
+/// This is a prefix-query optimization, not permission to widen or approximate
+/// the set. In particular, change-prefix ambiguity compares distinct change IDs,
+/// not the number of divergent commits. Errors must remain errors.
+///
+/// Implementations must own their immutable selection and any I/O context. The
+/// synchronous commit-prefix API blocks on these futures, like the existing
+/// global Index API, so I/O must not depend on the blocked caller's executor.
+#[async_trait::async_trait]
+pub trait PrefixDisambiguationIndex: Send + Sync {
+    async fn resolve_commit_prefix(
+        &self,
+        prefix: &HexPrefix,
+    ) -> IndexResult<PrefixResolution<CommitId>>;
+
+    async fn resolve_change_prefix(
+        &self,
+        prefix: &HexPrefix,
+    ) -> IndexResult<PrefixResolution<ChangeId>>;
+
+    /// None means the target is outside the disambiguation set. Some is the
+    /// exact shortest length within that set; zero is a valid length.
+    async fn shortest_commit_prefix_len(&self, id: &CommitId) -> IndexResult<Option<usize>>;
+
+    /// Membership means any selected commit has this change ID. The returned
+    /// length distinguishes change IDs, not divergent targets of one change.
+    async fn shortest_change_prefix_len(&self, id: &ChangeId) -> IndexResult<Option<usize>>;
+}
+
 struct DisambiguationData {
     expression: Arc<UserRevsetExpression>,
-    indexes: OnceCell<Indexes>,
+    indexes: OnceCell<DisambiguationIndexes>,
+}
+
+enum DisambiguationIndexes {
+    Materialized(Indexes),
+    Delegated(Arc<dyn PrefixDisambiguationIndex>),
 }
 
 struct Indexes {
