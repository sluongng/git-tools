+            }
 
             let commit_change_ids: Vec<_> = revset.commit_change_ids().try_collect().block_on()?;
             let mut commit_index = IdIndex::with_capacity(commit_change_ids.len());
@@ -80,11 +122,11 @@
                 commit_index.insert(commit_id, i);
