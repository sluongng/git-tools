 pub trait Revset: fmt::Debug {
+    /// Optional independently owned prefix index for this exact selection.
+    ///
+    /// Constructing it must not enumerate the selected history. Implementations
+    /// must preserve the entire selection, including filters, or return None so
+    /// the existing materialized path remains authoritative. This does not
+    /// change stream projections or grant access to canonical object bodies.
+    fn prefix_disambiguation_index(
+        &self,
+    ) -> crate::index::IndexResult<Option<Arc<dyn crate::id_prefix::PrefixDisambiguationIndex>>>
+    {
+        Ok(None)
+    }
+
     /// Streams in topological order with children before parents.
     // TODO: Relax to BoxStream?
     fn stream<'a>(&self) -> LocalBoxStream<'a, Result<CommitId, RevsetEvaluationError>>
