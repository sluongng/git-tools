--- /dev/null
+++ b/src/task_group.rs
@@ -0,0 +1,51 @@
+use std::{
+    future::Future,
+    sync::{Arc, Mutex},
+};
+use tokio::task::{AbortHandle, JoinSet};
+
+#[derive(Default)]
+struct State {
+    stopped: bool,
+    tasks: JoinSet<()>,
+}
+
+/// One serving invocation owns all connections and their nested parser/reader
+/// and RPC workers. Stopping admission and taking the set is one atomic step.
+#[derive(Default)]
+pub(crate) struct TaskGroup {
+    state: Mutex<State>,
+}
+impl TaskGroup {
+    pub(crate) fn spawn(
+        &self,
+        future: impl Future<Output = ()> + Send + 'static,
+    ) -> Option<AbortHandle> {
+        let mut state = self.state.lock().unwrap();
+        if state.stopped {
+            return None;
+        }
+        // Reap finished requests during ordinary serving: shutdown ownership
+        // must not turn a long-lived server into an unbounded task archive.
+        while state.tasks.try_join_next().is_some() {}
+        Some(state.tasks.spawn(future))
+    }
+    fn stop(&self) -> JoinSet<()> {
+        let mut state = self.state.lock().unwrap();
+        state.stopped = true;
+        state.tasks.abort_all();
+        std::mem::take(&mut state.tasks)
+    }
+    pub(crate) async fn shutdown(&self) {
+        let mut tasks = self.stop();
+        while tasks.join_next().await.is_some() {}
+    }
+}
+/// Cancellation still closes every task. Explicit shutdown additionally joins
+/// them, proving filesystem references have ended before a generation is freed.
+pub(crate) struct StopOnDrop(pub(crate) Arc<TaskGroup>);
+impl Drop for StopOnDrop {
+    fn drop(&mut self) {
+        drop(self.0.stop());
+    }
+}
