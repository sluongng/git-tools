+    // Retained crash orphans still occupy names even though the current version
+    // does not reference them. Do not reuse those IDs after validation finishes.
+    pub(crate) fn preserved_next_file_id(
+        folder: &Path,
+        mut highest_id: Option<u64>,
+    ) -> crate::Result<u64> {
+        for entry in std::fs::read_dir(folder)? {
+            let name = entry?.file_name();
+            if name == ".DS_Store" || name.to_string_lossy().starts_with("._") {
+                continue;
+            }
+            let id = name
+                .to_str()
+                .and_then(|name| name.parse::<u64>().ok())
+                .ok_or(crate::Error::Unrecoverable)?;
+            highest_id = Some(highest_id.map_or(id, |highest| highest.max(id)));
+        }
+
+        let next_id = match highest_id {
+            Some(id) => id.checked_add(1).ok_or(crate::Error::Unrecoverable)?,
+            None => 0,
+        };
+        // SequenceNumberCounter reserves the MSB and cannot allocate this range.
+        if next_id >= 0x8000_0000_0000_0000 {
+            return Err(crate::Error::Unrecoverable);
+        }
+        Ok(next_id)
+    }
+
     /// Creates a new LSM-tree in a directory.
     fn create_new(config: Config) -> crate::Result<Self> {
         use crate::file::{fsync_directory, TABLES_FOLDER};
