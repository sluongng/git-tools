+        let highest_blob_file_id = index.current_version().blob_files.list_ids().copied().max();
+        let blob_file_id_to_continue_with = if index.config.preserve_existing_recovery {
+            crate::Tree::preserved_next_file_id(&blobs_folder, highest_blob_file_id)?
