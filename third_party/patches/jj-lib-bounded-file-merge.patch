+/// Failure of bounded selected-value resolution. Backend I/O admission and
+/// source authority remain owned by the caller; budget failure is never a
+/// successful unresolved value.
+#[derive(Debug, thiserror::Error)]
+pub enum BoundedFileResolveError {
+    #[error(transparent)]
+    Backend(#[from] BackendError),
+    #[error(transparent)]
+    Merge(#[from] files::FileMergeError),
+    #[error(transparent)]
+    Budget(#[from] crate::diff::LineDiffError),
+}
+
+fn bounded_value_bytes(value: Option<&TreeValue>) -> usize {
+    match value {
+        None => 1,
+        Some(TreeValue::File { id, copy_id, .. }) => id
+            .as_bytes()
+            .len()
+            .saturating_add(copy_id.as_bytes().len())
+            .saturating_add(64),
+        Some(TreeValue::Tree(id)) => id.as_bytes().len().saturating_add(64),
+        Some(TreeValue::Symlink(id)) => id.as_bytes().len().saturating_add(64),
+        Some(TreeValue::GitSubmodule(id)) => id.as_bytes().len().saturating_add(64),
+    }
+}
+
+/// Resolve only these selected path values, using stock line-merge semantics
+/// and one cumulative budget. No global tree resolution or unbounded merge is
+/// invoked. Missing/non-file terms and unresolved conflicts retain stock form.
+///
+/// Like the ordinary resolver, successful text resolution writes a derived FILE
+/// through `store`. Read-only query callers MUST supply an ephemeral backend;
+/// this API does not confer object authority or change backend I/O admission.
+pub async fn resolve_file_values_bounded(
+    store: &Arc<Store>,
+    path: &RepoPath,
+    values: MergedTreeValue,
+    budget: &mut crate::diff::LineDiffBudget,
+    mut check: impl FnMut() -> bool + Send,
+) -> Result<MergedTreeValue, BoundedFileResolveError> {
+    let resolved =
+        try_resolve_file_values_bounded(store, path, &values, budget, &mut check).await?;
+    Ok(resolved.unwrap_or(values))
+}
+
+async fn try_resolve_file_values_bounded(
+    store: &Arc<Store>,
+    path: &RepoPath,
+    values: &MergedTreeValue,
+    budget: &mut crate::diff::LineDiffBudget,
+    mut check: impl FnMut() -> bool + Send,
+) -> Result<Option<MergedTreeValue>, BoundedFileResolveError> {
+    use crate::diff::LineDiffError;
+    let options = store.merge_options();
+    if options.hunk_level != FileMergeHunkLevel::Line {
+        return Err(files::FileMergeError::UnsupportedHunkLevel.into());
+    }
+    let cost = |value: &Option<TreeValue>| bounded_value_bytes(value.as_ref());
+    if let Some(value) =
+        files::trivial_bounded(values, options.same_change, &cost, budget, &mut check)?
+    {
+        budget.charge_merge_work(cost(value), &mut check)?;
+        budget.charge_merge_allocation(cost(value))?;
+        return Ok(Some(Merge::resolved(value.clone())));
+    }
+    let count = values.as_slice().len();
+    budget.charge_merge_work(count, &mut check)?;
+    budget.charge_merge_allocation(
+        // Merge::map collects into SmallVec, which can round heap capacity
+        // up to the next power of two; reserve that conservative bound first.
+        count
+            .checked_mul(2)
+            .and_then(|slots| slots.checked_mul(std::mem::size_of::<Option<&TreeValue>>()))
+            .ok_or(LineDiffError::LimitExceeded)?,
+    )?;
+    let borrowed = values.map(Option::as_ref);
+    let simplified = files::simplify_bounded(
+        &borrowed,
+        &|value: &Option<&TreeValue>| bounded_value_bytes(*value),
+        budget,
+        &mut check,
+    )?;
+    // Match stock's early metadata checks before requesting any FILE body.
+    if simplified
+        .iter()
+        .any(|term| !matches!(term, Some(TreeValue::File { .. })))
+    {
+        return Ok(None);
+    }
+    let count = simplified.as_slice().len();
+    // Three Merge::map collections, each with at most twice the term count.
+    budget.charge_merge_allocation(
+        count
+            .checked_mul(6 * std::mem::size_of::<&backend::FileId>())
+            .ok_or(LineDiffError::LimitExceeded)?,
+    )?;
+    budget.charge_merge_work(
+        count.checked_mul(4).ok_or(LineDiffError::LimitExceeded)?,
+        &mut check,
+    )?;
+    let ids = simplified.map(|term| match term {
+        Some(TreeValue::File { id, .. }) => id,
+        _ => unreachable!(),
+    });
+    let executable = simplified.map(|term| match term {
+        Some(TreeValue::File { executable, .. }) => executable,
+        _ => unreachable!(),
+    });
+    let copies = simplified.map(|term| match term {
+        Some(TreeValue::File { copy_id, .. }) => copy_id,
+        _ => unreachable!(),
+    });
+    let Some(&&executable) = files::trivial_bounded(
+        &executable,
+        SameChange::Accept,
+        &|_: &&bool| 1,
+        budget,
+        &mut check,
+    )?
+    else {
+        return Ok(None);
+    };
+    let Some(&copy_id) = files::trivial_bounded(
+        &copies,
+        SameChange::Accept,
+        &|value: &&backend::CopyId| value.as_bytes().len(),
+        budget,
+        &mut check,
+    )?
+    else {
+        return Ok(None);
+    };
+    if let Some(&id) = files::trivial_bounded(
+        &ids,
+        options.same_change,
+        &|value: &&backend::FileId| value.as_bytes().len(),
+        budget,
+        &mut check,
+    )? {
+        let bytes = id
+            .as_bytes()
+            .len()
+            .saturating_add(copy_id.as_bytes().len())
+            .saturating_add(64);
+        budget.charge_merge_work(bytes, &mut check)?;
+        budget.charge_merge_allocation(bytes)?;
+        return Ok(Some(Merge::normal(TreeValue::File {
+            id: id.clone(),
+            executable,
+            copy_id: copy_id.clone(),
+        })));
+    }
+    let ids = files::simplify_bounded(
+        &ids,
+        &|value: &&backend::FileId| value.as_bytes().len(),
+        budget,
+        &mut check,
+    )?;
+    budget.charge_merge_allocation(
+        ids.as_slice()
+            .len()
+            .checked_mul(std::mem::size_of::<Vec<u8>>())
+            .ok_or(LineDiffError::LimitExceeded)?,
+    )?;
+    let mut contents = Vec::with_capacity(ids.as_slice().len());
+    let mut loaded = 0usize;
+    for id in &ids {
+        budget.charge_merge_work(1, &mut check)?;
+        let mut reader = store.read_file(path, id).await?;
+        budget.charge_merge_work(1, &mut check)?;
+        let mut bytes = Vec::new();
+        let mut chunk = [0u8; 16 * 1024];
+        loop {
+            budget.charge_merge_work(1, &mut check)?;
+            let count =
+                reader
+                    .read(&mut chunk)
+                    .await
+                    .map_err(|error| BackendError::ReadObject {
+                        object_type: id.object_type(),
+                        hash: id.hex(),
+                        source: error.into(),
+                    })?;
+            budget.charge_merge_work(count, &mut check)?;
+            if count == 0 {
+                break;
+            }
+            loaded = loaded
+                .checked_add(count)
+                .filter(|n| *n <= budget.remaining_input_bytes())
+                .ok_or(LineDiffError::LimitExceeded)?;
+            let required = bytes
+                .len()
+                .checked_add(count)
+                .ok_or(LineDiffError::LimitExceeded)?;
+            if required > bytes.capacity() {
+                budget.charge_merge_allocation(required)?;
+                bytes
+                    .try_reserve_exact(required - bytes.len())
+                    .map_err(|_| LineDiffError::LimitExceeded)?;
+            }
+            bytes.extend_from_slice(&chunk[..count]);
+        }
+        contents.push(bytes);
+    }
+    let contents = Merge::from_vec(contents);
+    let Some(merged) = files::try_merge_bounded(&contents, options, budget, &mut check)? else {
+        return Ok(None);
+    };
+    budget.charge_merge_work(merged.len().saturating_add(1), &mut check)?;
+    budget.charge_merge_allocation(copy_id.as_bytes().len().saturating_add(64))?;
+    let id = store.write_file(path, &mut merged.as_slice()).await?;
+    budget.charge_merge_work(1, &mut check)?;
+    Ok(Some(Merge::normal(TreeValue::File {
+        id,
+        executable,
+        copy_id: copy_id.clone(),
+    })))
+}
+
 async fn try_resolve_file_values<T: Borrow<TreeValue>>(
     store: &Arc<Store>,
     path: &RepoPath,
