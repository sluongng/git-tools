+use super::*;
+use crate::diff::{LineDiffBudget, LineDiffError};
+
+/// A bounded file merge either finishes with stock line semantics or fails
+/// without returning a partial result. Word-level merging is deliberately not
+/// delegated to the unbounded word diff.
+#[derive(Debug, thiserror::Error)]
+pub enum FileMergeError {
+    #[error(transparent)]
+    Budget(#[from] LineDiffError),
+    #[error("bounded file merging requires line hunks")]
+    UnsupportedHunkLevel,
+}
+
+fn capacity<T>(budget: &mut LineDiffBudget, count: usize) -> Result<(), LineDiffError> {
+    budget.charge_merge_allocation(
+        count
+            .checked_mul(std::mem::size_of::<T>())
+            .ok_or(LineDiffError::LimitExceeded)?,
+    )
+}
+fn equal<T: Eq>(
+    left: &T,
+    right: &T,
+    cost: &impl Fn(&T) -> usize,
+    budget: &mut LineDiffBudget,
+    check: &mut impl FnMut() -> bool,
+) -> Result<bool, LineDiffError> {
+    budget.charge_merge_work(cost(left).max(cost(right)).saturating_add(1), check)?;
+    Ok(left == right)
+}
+
+// Match Merge::resolve_trivial, including its ordered three-term fast path.
+// Linear counted buckets avoid an uncancellable hash/equality operation over
+// arbitrarily large caller values; every comparison is explicitly charged.
+pub(crate) fn trivial_bounded<'a, T: Eq>(
+    values: &'a Merge<T>,
+    same_change: SameChange,
+    cost: &impl Fn(&T) -> usize,
+    budget: &mut LineDiffBudget,
+    check: &mut impl FnMut() -> bool,
+) -> Result<Option<&'a T>, LineDiffError> {
+    budget.charge_merge_work(1, &mut *check)?;
+    let values = values.as_slice();
+    if let [one] = values {
+        return Ok(Some(one));
+    }
+    if let [left, base, right] = values {
+        return if equal(left, right, cost, budget, check)? && same_change == SameChange::Accept {
+            Ok(Some(left))
+        } else if equal(left, base, cost, budget, check)? {
+            Ok(Some(right))
+        } else if equal(right, base, cost, budget, check)? {
+            Ok(Some(left))
+        } else {
+            Ok(None)
+        };
+    }
+    capacity::<(&T, i64)>(budget, values.len())?;
+    let mut counts: Vec<(&T, i64)> = Vec::with_capacity(values.len());
+    for (position, value) in values.iter().enumerate() {
+        budget.charge_merge_work(1, &mut *check)?;
+        let mut found = None;
+        for (at, (existing, _)) in counts.iter().enumerate() {
+            if equal(value, *existing, cost, budget, check)? {
+                found = Some(at);
+                break;
+            }
+        }
+        let delta = if position % 2 == 0 { 1 } else { -1 };
+        if let Some(at) = found {
+            counts[at].1 = counts[at]
+                .1
+                .checked_add(delta)
+                .ok_or(LineDiffError::LimitExceeded)?;
+        } else {
+            counts.push((value, delta));
+        }
+    }
+    capacity::<(&T, i64)>(budget, 2)?;
+    let mut nonzero = Vec::with_capacity(2);
+    for entry in counts {
+        budget.charge_merge_work(1, &mut *check)?;
+        if entry.1 != 0 {
+            if nonzero.len() == 2 {
+                return Ok(None);
+            }
+            nonzero.push(entry);
+        }
+    }
+    Ok(match nonzero.as_slice() {
+        [(value, _)] => Some(*value),
+        [(left, left_count), (right, _)] if same_change == SameChange::Accept => {
+            Some(if *left_count > 0 { *left } else { *right })
+        }
+        _ => None,
+    })
+}
+
+// Preserve Merge::get_simplified_mapping's pairing and ordering exactly.
+pub(crate) fn simplify_bounded<T: Eq + Clone>(
+    values: &Merge<T>,
+    cost: &impl Fn(&T) -> usize,
+    budget: &mut LineDiffBudget,
+    check: &mut impl FnMut() -> bool,
+) -> Result<Merge<T>, LineDiffError> {
+    capacity::<usize>(budget, values.as_slice().len())?;
+    let mut mapping: Vec<_> = (0..values.as_slice().len()).collect();
+    let mut add = 0;
+    while add < mapping.len() {
+        budget.charge_merge_work(1, &mut *check)?;
+        let mut found = None;
+        for remove in (1..mapping.len()).step_by(2) {
+            if equal(
+                &values.as_slice()[mapping[remove]],
+                &values.as_slice()[mapping[add]],
+                cost,
+                budget,
+                check,
+            )? {
+                found = Some(remove);
+                break;
+            }
+        }
+        if let Some(remove) = found {
+            budget.charge_merge_work(mapping.len(), &mut *check)?;
+            mapping.swap(remove + 1, add);
+            let next_len = mapping.len() - 2;
+            for at in remove..next_len {
+                budget.charge_merge_work(1, &mut *check)?;
+                mapping[at] = mapping[at + 2];
+            }
+            mapping.truncate(next_len);
+        } else {
+            add += 2;
+        }
+    }
+    capacity::<T>(budget, mapping.len())?;
+    let mut result = Vec::with_capacity(mapping.len());
+    for at in mapping {
+        let value = &values.as_slice()[at];
+        budget.charge_merge_work(cost(value).saturating_add(1), &mut *check)?;
+        budget.charge_merge_allocation(cost(value))?;
+        result.push(value.clone());
+    }
+    Ok(Merge::from_vec(result))
+}
+
+fn append(
+    output: &mut Vec<u8>,
+    bytes: &[u8],
+    budget: &mut LineDiffBudget,
+    check: &mut impl FnMut() -> bool,
+) -> Result<(), LineDiffError> {
+    let required = output
+        .len()
+        .checked_add(bytes.len())
+        .ok_or(LineDiffError::LimitExceeded)?;
+    budget.charge_merge_work(1, &mut *check)?;
+    if required > output.capacity() {
+        budget.charge_merge_allocation(required)?;
+        output
+            .try_reserve_exact(required - output.len())
+            .map_err(|_| LineDiffError::LimitExceeded)?;
+    }
+    for chunk in bytes.chunks(16 * 1024) {
+        budget.charge_merge_work(chunk.len(), &mut *check)?;
+        output.extend_from_slice(chunk);
+    }
+    Ok(())
+}
+
+/// Stock-equivalent line merge with a shared cumulative diff/merge budget.
+/// Borrowed input storage and backend transport remain caller-owned. The
+/// budget additionally covers merge terms, equality, hunk and output storage.
+pub fn merge_bounded<T: AsRef<[u8]>>(
+    inputs: &Merge<T>,
+    options: &MergeOptions,
+    budget: &mut LineDiffBudget,
+    mut check: impl FnMut() -> bool,
+) -> Result<Merge<BString>, FileMergeError> {
+    Ok(collect(inputs, options, budget, &mut check, false)?
+        .expect("full merge always returns terms"))
+}
+
+/// Like try_merge, but bounded. An unresolved merge returns None; exhaustion
+/// and cancellation are errors, never an unresolved or partial success.
+pub fn try_merge_bounded<T: AsRef<[u8]>>(
+    inputs: &Merge<T>,
+    options: &MergeOptions,
+    budget: &mut LineDiffBudget,
+    mut check: impl FnMut() -> bool,
+) -> Result<Option<BString>, FileMergeError> {
+    Ok(
+        collect(inputs, options, budget, &mut check, true)?.map(|value| {
+            value
+                .into_resolved()
+                .ok()
+                .expect("resolved-only collection")
+        }),
+    )
+}
+
+fn collect<T: AsRef<[u8]>>(
+    inputs: &Merge<T>,
+    options: &MergeOptions,
+    budget: &mut LineDiffBudget,
+    check: &mut impl FnMut() -> bool,
+    resolved_only: bool,
+) -> Result<Option<Merge<BString>>, FileMergeError> {
+    if options.hunk_level != FileMergeHunkLevel::Line {
+        return Err(FileMergeError::UnsupportedHunkLevel);
+    }
+    let count = inputs.as_slice().len();
+    budget.charge_merge_work(count, &mut *check)?;
+    capacity::<&[u8]>(budget, count)?;
+    // Explicit capacity avoids generic collect's minimum-capacity rounding.
+    let mut ordered = Vec::with_capacity(count);
+    for input in inputs.removes().chain(inputs.adds()) {
+        budget.charge_merge_work(1, &mut *check)?;
+        ordered.push(input.as_ref());
+    }
+    let diff = ContentDiff::by_line_bounded_many(&ordered, budget, &mut *check)?;
+    // The iterator owns position and hunk bookkeeping for each input.
+    budget.charge_merge_allocation(count.checked_mul(256).ok_or(LineDiffError::LimitExceeded)?)?;
+    let mut hunks = diff.hunks();
+    capacity::<Vec<u8>>(budget, 1)?;
+    let mut output = vec![Vec::new()];
+    loop {
+        budget.charge_merge_work(1, &mut *check)?;
+        // DiffHunkContentVec collects into SmallVec, whose heap capacity can
+        // round up to the next power of two. Precharge that before next().
+        capacity::<&BStr>(
+            budget,
+            count.checked_mul(2).ok_or(LineDiffError::LimitExceeded)?,
+        )?;
+        let Some(hunk) = hunks.next() else {
+            break;
+        };
+        let values = if hunk.kind == DiffHunkKind::Matching {
+            Merge::resolved(hunk.contents[0])
+        } else {
+            capacity::<&BStr>(budget, count)?;
+            let removes = inputs.removes().len();
+            let mut values = Vec::with_capacity(count);
+            for at in 0..inputs.num_sides() {
+                budget.charge_merge_work(1, &mut *check)?;
+                values.push(hunk.contents[removes + at]);
+                if at < removes {
+                    values.push(hunk.contents[at]);
+                }
+            }
+            Merge::from_vec(values)
+        };
+        if let Some(&value) = trivial_bounded(
+            &values,
+            options.same_change,
+            &|v: &&BStr| v.len(),
+            budget,
+            check,
+        )? {
+            for buffer in &mut output {
+                append(buffer, value.as_ref(), budget, check)?;
+            }
+        } else {
+            if resolved_only {
+                return Ok(None);
+            }
+            if output.len() == 1 {
+                capacity::<Vec<u8>>(budget, count)?;
+                let prefix = output.pop().unwrap();
+                let mut expanded = Vec::with_capacity(count);
+                for _ in 0..count {
+                    let mut copy = Vec::new();
+                    append(&mut copy, &prefix, budget, check)?;
+                    expanded.push(copy);
+                }
+                output = expanded;
+            }
+            for (buffer, value) in output.iter_mut().zip(values.iter()) {
+                append(buffer, value.as_ref(), budget, check)?;
+            }
+        }
+    }
+    capacity::<BString>(budget, output.len())?;
+    Ok(Some(Merge::from_vec(
+        output.into_iter().map(BString::from).collect::<Vec<_>>(),
+    )))
+}
