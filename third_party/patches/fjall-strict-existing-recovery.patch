+    /// Inspect an existing database without repair, cleanup or background writes.
+    /// Call `finish_recovery_validation` after application-level validation.
+    /// Missing state, invalid WAL batches and Clear records are rejected.
+    #[must_use]
+    pub fn strict_existing_recovery(mut self, strict: bool) -> Self {
+        self.inner.strict_existing_recovery = strict;
+        self
+    }
+
+    /// Bound encoded and decoded record sizes during strict recovery.
+    /// The default is 64 MiB; ordinary recovery is unchanged.
+    #[must_use]
+    pub fn strict_recovery_max_record_bytes(mut self, bytes: usize) -> Self {
+        self.inner.strict_recovery_max_record_bytes = bytes;
+        self
+    }
+
+    /// Bound retained bytes in a strict recovery batch (default 256 MiB).
+    #[must_use]
+    pub fn strict_recovery_max_batch_bytes(mut self, bytes: usize) -> Self {
+        self.inner.strict_recovery_max_batch_bytes = bytes;
+        self
+    }
+
+    /// Bound the number of entries in a strict recovery batch (default one million).
+    #[must_use]
+    pub fn strict_recovery_max_batch_items(mut self, count: usize) -> Self {
+        self.inner.strict_recovery_max_batch_items = count;
+        self
+    }
+
+    /// Bound total physical WAL bytes inspected in strict recovery (default 1 GiB).
+    /// File sizes are checked before journal decoding or zero-padding scans.
+    #[must_use]
+    pub fn strict_recovery_max_scan_bytes(mut self, bytes: u64) -> Self {
+        self.inner.strict_recovery_max_scan_bytes = bytes;
+        self
+    }
+
+    /// Bound journal fragments during strict recovery (default 1024).
+    /// Directory enumeration is also bounded, allowing sixteen other database entries.
+    #[must_use]
+    pub fn strict_recovery_max_journals(mut self, count: usize) -> Self {
+        self.inner.strict_recovery_max_journals = count;
+        self
+    }
+
     /// Sets the cache capacity in bytes.
     ///
     /// It is recommended to configure the block cache capacity to be ~20-25% of the available memory - or more **if** the data set _fully_ fits into memory.
