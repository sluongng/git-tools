+
+    /// Finish an opt-in strict recovery after application-level validation.
+    /// Until this succeeds, supported mutation APIs reject writes. Rejected
+    /// inspection can be dropped without trimming or cleaning existing files.
+    pub fn finish_recovery_validation(&self) -> crate::Result<()> {
+        let _validation = self
+            .recovery_validation
+            .lock()
+            .map_err(|_| crate::Error::Poisoned)?;
+        if !self.config.strict_existing_recovery {
+            return Ok(());
+        }
+        let writer = self.supervisor.journal.get_writer()?;
+        if !writer
+            .validation_pending
+            .load(std::sync::atomic::Ordering::Acquire)
+        {
+            return Ok(());
+        }
+        if self.is_poisoned.is_poisoned() {
+            return Err(crate::Error::Poisoned);
+        }
+        let trims = self
+            .recovery_trims
+            .lock()
+            .map_err(|_| crate::Error::Poisoned)?;
+        for (path, logical_end, original_len) in trims.iter() {
+            let file = std::fs::OpenOptions::new().write(true).open(path)?;
+            if file.metadata()?.len() != *original_len || logical_end > original_len {
+                return Err(crate::Error::Unrecoverable);
+            }
+            if logical_end < original_len {
+                file.set_len(*logical_end)?;
+                file.sync_all()?;
+            }
+        }
+        // All application checks have succeeded; only now may maintenance run.
+        if let Err(error) = self.start_recovered_workers() {
+            self.is_poisoned.poison();
+            self.stop_signal.send();
+            return Err(error);
+        }
+        writer
+            .validation_pending
+            .store(false, std::sync::atomic::Ordering::Release);
+        Ok(())
+    }
+
+    fn start_recovered_workers(&self) -> crate::Result<()> {
+        for keyspace in self
             .supervisor
             .keyspaces
             .read()
