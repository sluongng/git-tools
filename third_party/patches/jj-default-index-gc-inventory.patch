+    /// Inventories every indexed commit at each explicit retained operation.
+    ///
+    /// This observation never builds, repairs, initializes, or removes index
+    /// state and never calls a backend. Hidden and non-head indexed commits are
+    /// included; callers must also inventory OP/VIEW, working-copy and sidecar
+    /// roots under their own mutation/collection fences. Trusted index-directory
+    /// ownership and concurrent-mutation exclusion are caller responsibilities.
+    ///
+    /// Supply the actual operation store's intrinsic root identities. Only a
+    /// missing association for that exact root operation yields its root commit;
+    /// missing nonroot associations and corrupt existing files are errors.
+    /// Changed-path caches cannot add commit roots and are not loaded. Limits
+    /// fail with `InvalidInput`, malformed data with `InvalidData`, and I/O errors
+    /// retain their kind. No partial result is returned on failure.
+    pub fn gc_roots_readonly(
+        &self,
+        operations: &[OperationId],
+        root_operation: &OperationId,
+        root_commit: &CommitId,
+        change_id_length: usize,
+        limits: super::gc::DefaultIndexGcLimits,
+    ) -> io::Result<Vec<CommitId>> {
+        super::gc::roots(
+            &self.dir,
+            operations,
+            root_operation,
+            root_commit,
+            change_id_length,
+            limits,
+        )
+    }
+
     pub fn reinit(&self) -> Result<(), DefaultIndexStoreInitError> {
         // Create base directories in case the store was initialized by old jj.
         self.ensure_base_dirs()?;
