diff --git a/src/recovery_allocation.rs b/src/recovery_allocation.rs
new file mode 100644
index 0000000..72a82c5
--- /dev/null
+++ b/src/recovery_allocation.rs
@@ -0,0 +1,52 @@
+//! Optional WAL allocation policy shared by writers and strict recovery.
+use crate::journal::batch_reader::ReadBatchItem;
+
+/// Allocation limits for every newly written WAL batch and strict recovery.
+/// Existing data exceeding a newly selected policy is incompatible, not repaired.
+/// Total historical journal bytes are streamed and are not a live-memory quota.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct RecoveryAllocationLimits {
+    /// Maximum encoded or decoded item bytes, including its 21-byte header.
+    pub max_record_bytes: usize,
+    /// Maximum sum of retained decoded item charges in a batch.
+    pub max_batch_bytes: usize,
+    /// Maximum item count in a batch.
+    pub max_batch_items: usize,
+    /// Includes the active journal. Rotation pauses at this bound; flushing does not.
+    pub max_journals: usize,
+}
+impl RecoveryAllocationLimits {
+    pub(crate) fn validate(self) -> crate::Result<()> {
+        if self.max_record_bytes < 21
+            || self.max_batch_bytes == 0
+            || self.max_batch_items == 0
+            || self.max_journals == 0
+        {
+            return Err(crate::Error::RecoveryAllocationLimit);
+        }
+        Ok(())
+    }
+    pub(crate) fn record(self, key: usize, value: usize, packed: usize) -> crate::Result<()> {
+        let fits = |n: usize| {
+            key.checked_add(n)
+                .and_then(|n| n.checked_add(21))
+                .is_some_and(|n| n <= self.max_record_bytes)
+        };
+        if key > u16::MAX as usize
+            || value > u32::MAX as usize
+            || packed > u32::MAX as usize
+            || !fits(value)
+            || !fits(packed)
+        {
+            return Err(crate::Error::RecoveryAllocationLimit);
+        }
+        Ok(())
+    }
+}
+/// The same retained-vector/slack charge is used before WAL writes and decode pushes.
+pub(crate) fn batch_charge(total: usize, key: usize, value: usize) -> crate::Result<usize> {
+    key.checked_add(value)
+        .and_then(|n| n.checked_add(std::mem::size_of::<ReadBatchItem>() + 64))
+        .and_then(|n| total.checked_add(n))
+        .ok_or(crate::Error::RecoveryAllocationLimit)
+}
