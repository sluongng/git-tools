+    pub(crate) fn can_rotate(&self) -> crate::Result<bool> {
+        let Some(limits) = self.allocation_limits else {
+            return Ok(true);
+        };
+        let folder = self.path.parent().ok_or(crate::Error::Unrecoverable)?;
+        let mut count = 0usize;
+        for item in std::fs::read_dir(folder)? {
+            let item = item?;
+            if item
+                .path()
+                .extension()
+                .is_some_and(|extension| extension.eq_ignore_ascii_case("jnl"))
+            {
+                if !item.file_type()?.is_file() {
+                    return Err(crate::Error::Unrecoverable);
+                }
+                count = count
+                    .checked_add(1)
+                    .ok_or(crate::Error::RecoveryAllocationLimit)?;
+                if count >= limits.max_journals {
+                    return Ok(false);
+                }
+            }
+        }
+        Ok(true)
+    }
+    fn check_item(&self, key: &[u8], value: &[u8], total: usize) -> crate::Result<usize> {
+        let Some(limits) = self.allocation_limits else {
+            return Ok(total);
+        };
+        // Check raw lengths before the codec's wire-size arithmetic.
+        limits.record(key.len(), value.len(), value.len())?;
+        let mut packed = value.len();
+        #[cfg(feature = "lz4")]
+        if self.compression == CompressionType::Lz4
+            && self.compression_threshold > 0
+            && value.len() >= self.compression_threshold
+        {
+            packed = usize::try_from(20 + (value.len() as u64 * 110 / 100))
+                .map_err(|_| crate::Error::RecoveryAllocationLimit)?;
+        }
+        limits.record(key.len(), value.len(), packed)?;
+        let total = crate::recovery_allocation::batch_charge(total, key.len(), value.len())?;
+        if total > limits.max_batch_bytes {
+            return Err(crate::Error::RecoveryAllocationLimit);
+        }
+        Ok(total)
+    }
