diff --git a/src/builder.rs b/src/builder.rs
index 5766104..4b24583 100644
--- a/src/builder.rs
+++ b/src/builder.rs
@@ -32,9 +32,24 @@ impl<O: Openable> Builder<O> {
     ///
     /// Errors if an I/O error occurred, or if the database can not be opened.
     pub fn open(self) -> crate::Result<O> {
+        if let Some(limits) = self.inner.recovery_allocation_limits {
+            limits.validate()?;
+        }
         O::open(self.inner)
     }
 
+    /// Apply one allocation policy to normal WAL writers and strict recovery.
+    /// With a policy, legacy strict-only allocation/physical-scan knobs are ignored.
+    /// Historical bytes are streamed; journal rotation pauses at the inventory cap.
+    #[must_use]
+    pub fn recovery_allocation_limits(
+        mut self,
+        limits: Option<crate::RecoveryAllocationLimits>,
+    ) -> Self {
+        self.inner.recovery_allocation_limits = limits;
+        self
+    }
+
     /// Inspect an existing database without repair, cleanup or background writes.
     /// Call `finish_recovery_validation` after application-level validation.
     /// Missing state, invalid WAL batches and Clear records are rejected.
