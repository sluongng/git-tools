crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")

# Native source retention needs every retained operation, including detached
# operations kept by the operation store's age policy.
crate.annotation(
    crate = "jj-lib",
    patch_args = ["-p1"],
    patches = [
        "//third_party/patches:jj-retained-operation-inventory.patch",
        "//third_party/patches:jj-default-index-gc-inventory.patch",
        "//third_party/patches:jj-cloud-operation-codec.patch",
        "//third_party/patches:jj-cloud-restore-heads.patch",
        "//third_party/patches:jj-index-capabilities.patch",
        "//third_party/patches:jj-merge-prepared-index.patch",
        "//third_party/patches:jj-lazy-prefix-context.patch",
        "//third_party/patches:jj-external-rewrites.patch",
        "//third_party/patches:jj-lib-bounded-file-merge.patch",
        "//third_party/patches:jj-lib-bounded-fileset-matcher.patch",
    ],
    version = "0.46.0",
)

# Remote annotation uses jj's literal matching policy with bounded physical work.
crate.annotation(
    crate = "jj-core",
    patch_args = ["-p1"],
    patches = [
        "//third_party/patches:jj-core-bounded-line-diff.patch",
        "//third_party/patches:jj-core-bounded-multi-line-diff.patch",
        "//third_party/patches:jj-core-bounded-file-merge.patch",
        "//third_party/patches:jj-core-bounded-fileset-matcher.patch",
    ],
    version = "0.46.0",
)

# Bounded stock matchers explicitly select a single runtime cache-pool shard.
crate.annotation(
    crate = "regex",
    patch_args = ["-p1"],
    patches = ["//third_party/patches:regex-set-pool-capacity.patch"],
    version = "1.13.1",
)
