common --noannounce_rc
# Disable optional build-rule telemetry for hermetic repository setup.
common --repo_env=DO_NOT_TRACK=1
build --incompatible_strict_action_env
build --compilation_mode=opt
build --enable_platform_specific_config
# Git and its HTTP transport must use the same TLS implementation.
build --@curl//:ssl_lib=openssl
build --jobs=16
test --test_output=errors

# Hermetic Rust/LLVM toolchains are identical locally and on remote executors.
common:rbe --remote_executor=grpcs://remote.buildbuddy.io
common:rbe --remote_cache=grpcs://remote.buildbuddy.io
common:rbe --bes_backend=grpcs://remote.buildbuddy.io
common:rbe --bes_results_url=https://app.buildbuddy.io/invocation/
build:rbe --extra_execution_platforms=//:rbe_linux_x86_64
build:rbe --remote_timeout=600
build:rbe --remote_download_toplevel
build:rbe --remote_cache_compression
build:rbe --jobs=64

# Share the RBE platform/cache/BES configuration, but compile cache misses locally.
common:cache-only --config=rbe
common:cache-only --remote_executor=

# Local endpoint overrides and credentials are never checked in.
try-import %workspace%/user.bazelrc
